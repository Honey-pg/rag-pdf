# Server Environment
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Reranking Engine (Jina AI)
JINA_API_KEY=your_jina_api_key_here

# Speech-to-Text Transcription (Groq Whisper)
GROQ_API_KEY=your_groq_api_key_here

# PDF OCR Parsing (LlamaParse)
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here

# Supabase State & Memory Database (Optional)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_secret_key_here

# Clerk Authentication (JWKS verification)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
